# Copy this file to .env.local and add values from Firebase Console.
# Keep organiser accounts in Firebase Authentication; do not put passwords here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase Admin configuration for registrations and organiser APIs.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional alternative to GOOGLE_APPLICATION_CREDENTIALS; keep the JSON secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
ORGANIZER_EMAILS=

# Set this only after the website is deployed.
# Example: https://your-hackathon-site.web.app
VITE_PUBLIC_SITE_URL=

# Server-side RAG configuration. Keep the real key in .env.local only.
GROK_API_KEY="sk-SzJclytWmAGS3UzzqOBfmIYoTsoJ02TGzbcLbA7jyPuZgl2M"
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_BATCH_SIZE=64
API_PORT=3001
RAG_DATA_DIR=data/rag
LANCEDB_PATH=data/rag/vectors
RAG_CHUNK_SIZE_CHARS=2000
RAG_CHUNK_OVERLAP_CHARS=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=16000
