{
  "name": "hacthon-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:api\" \"vite\"",
    "dev:api": "node --env-file-if-exists=.env.local server/index.js",
    "test": "node --test server",
    "registrations:migrate": "node --env-file-if-exists=.env.local server/migrateRegistrations.js",
    "test:preprocessing": "node --test server/preprocessing.test.js",
    "test:chunking": "node --test server/chunking.test.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.41.0",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.78.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.65.0",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
